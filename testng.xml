<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="OrangeHRM Automation Suite" parallel="tests" thread-count="3" verbose="1">
    <listeners>
        <listener class-name="listeners.TestListener"/>
    </listeners>

    <test name="Login Tests">
        <classes>
            <class name="tests.LoginTests"/>
        </classes>
    </test>

    <test name="PIM Tests">
        <classes>
            <class name="tests.PIMTests"/>
        </classes>
    </test>

    <test name="Admin and UI Tests">
        <classes>
            <class name="tests.AdminAndUITests"/>
        </classes>
    </test>
</suite>
